    \begin{tikzpicture}
        [simple/.style={circle,draw=black,minimum size=8mm, align=center},
         api/.style={circle,draw=blue,ultra thick, minimum size=10mm, align=center}, 
         rotulo/.style={align=center,below, blue, font=\itshape}]
         %nodos do modelo
         \node (s1) at (0,0) [simple]{$a, b$};
         \node (s2) at (2,0) [simple]{$a, b$};
         \node (s3) at (0,3) [simple]{$a, b, c$};
         \node (s4) at (2,2) [simple]{$a, b, c$};
         \node (s5) at (2,4) [simple]{$a, b, c$};
         \node (call1) at (4,3) [api]{};
         \node (call2) at (4,0) [api]{};

         % nodos de rotulo
         \node at (call1.south) [rotulo]{call\\m1};
         \node at (call2.south) [rotulo]{call\\m1};
         \node at (s1.south)   [below]{$s_1$};
         \node at (s2.south)   [below]{$s_2$};
         \node at (s3.south)   [below]{$s_3$};
         \node at (s4.south)   [below]{$s_4$};
         \node at (s5.south)   [below]{$s_5$};

         % transicoes
         \draw [-{Stealth[round]}] (s1) to (s2);
         \draw [-{Stealth[round]}] (s2) to (call2);
         \draw [-{Stealth[round]}] (s3) to (s4);
         \draw [-{Stealth[round]}] (s3) to (s5);
         \draw [-{Stealth[round]}] (s4) to (call1);
         \draw [-{Stealth[round]}] (s5) to (call1);
         
    \end{tikzpicture}
